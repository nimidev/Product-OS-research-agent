# OpenAI API key (required for embeddings + LLM synthesis)
OPENAI_API_KEY=sk-your-key-here

# Qdrant storage mode: "local" (no Docker, default) or "server" (Docker/remote)
QDRANT_MODE=local
QDRANT_LOCAL_PATH=./qdrant_data

# Qdrant server connection (only used when QDRANT_MODE=server)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LLM model for synthesis (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Embedding model (default: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# SQLite database path
DATABASE_PATH=research_agent.db

# Log level
LOG_LEVEL=INFO
